# Set this for Android development: use 10.0.2.2 for the emulator or the
# development PC's LAN IP for a physical device on the same Wi-Fi.
# Release APKs take API_BASE_URL from --dart-define and require HTTPS.
API_BASE_URL=

# Chrome running on this same PC uses Laravel's local development server.
API_BASE_URL_WEB=http://127.0.0.1:8000/api/v1
